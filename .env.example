# SafeRoad AI Environment Configuration Template
# Duplicate this file as .env or .env.local for custom configurations and local overrides.
# NOTE: Do NOT commit .env or files with real secrets into source control.

# --- Geospatial & Atmospheric Telemetry Endpoints (Optional Overrides) ---
# Default: Official Open-Meteo public non-commercial weather forecast endpoint
VITE_OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# Default: Open Source Routing Machine (OSRM) driving route profile demo server
VITE_OSRM_ROUTER_URL=https://router.project-osrm.org

# Default: OpenStreetMap Nominatim reverse and forward geocoding endpoint
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Application Runtime & Observability ---
VITE_APP_ENV=development
VITE_APP_NAME="SafeRoad AI - Road Accident Risk Prediction & Safety Analytics"
VITE_ENABLE_VERBOSE_LOGS=false
